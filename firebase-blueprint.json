{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pribadi siswa SMPN 3 Karawang yang terisolasi per UID pengguna.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID pemilik akun",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Alamat email siswa",
          "maxLength": 160
        },
        "fullName": {
          "type": "string",
          "description": "Nama lengkap siswa",
          "minLength": 1,
          "maxLength": 80
        },
        "className": {
          "type": "string",
          "description": "Kelas siswa di SMPN 3 Karawang (contoh: 7A, 8B, 9C)",
          "minLength": 1,
          "maxLength": 16
        },
        "avatarId": {
          "type": "string",
          "description": "Pilihan ID avatar ilustrasi siswa",
          "enum": ["mint", "yellow", "sky", "lavender"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pendaftaran akun"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan profil terakhir"
        }
      },
      "required": ["uid", "email", "fullName", "className", "avatarId", "createdAt", "updatedAt"]
    },
    "DaySchedule": {
      "title": "DaySchedule",
      "description": "Jadwal pelajaran, pembiasaan pagi, dan ekstrakurikuler pribadi siswa untuk satu hari.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID pemilik jadwal",
          "minLength": 1,
          "maxLength": 128
        },
        "dayKey": {
          "type": "string",
          "description": "Kunci hari Senin hingga Minggu",
          "enum": ["senin", "selasa", "rabu", "kamis", "jumat", "sabtu", "minggu"]
        },
        "morningTitle": {
          "type": "string",
          "description": "Judul kegiatan pembiasaan pagi",
          "maxLength": 120
        },
        "morningTime": {
          "type": "string",
          "description": "Rentang waktu sesi pagi",
          "maxLength": 40
        },
        "morningEmoji": {
          "type": "string",
          "description": "Emoji sesi pagi",
          "maxLength": 16
        },
        "morningNote": {
          "type": "string",
          "description": "Catatan singkat sesi pagi",
          "maxLength": 240
        },
        "lessons": {
          "type": "array",
          "description": "Daftar mata pelajaran atau aktivitas inti harian (maksimal 20 item)"
        },
        "extracurriculars": {
          "type": "array",
          "description": "Daftar kegiatan sore / ekstrakurikuler (maksimal 10 item)"
        },
        "dailyQuote": {
          "type": "string",
          "description": "Kutipan penyemangat harian",
          "maxLength": 280
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan jadwal terakhir"
        }
      },
      "required": [
        "userId",
        "dayKey",
        "morningTitle",
        "morningTime",
        "morningEmoji",
        "morningNote",
        "lessons",
        "extracurriculars",
        "dailyQuote",
        "updatedAt"
      ]
    },
    "HomeworkTask": {
      "title": "HomeworkTask",
      "description": "Catatan PR atau tugas sekolah pribadi milik siswa.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dayKey": {
          "type": "string",
          "enum": ["senin", "selasa", "rabu", "kamis", "jumat", "sabtu", "minggu"]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "notes": {
          "type": "string",
          "maxLength": 400
        },
        "dueDate": {
          "type": "string",
          "maxLength": 40
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "dayKey", "subject", "title", "notes", "dueDate", "completed", "createdAt", "updatedAt"]
    },
    "BagChecklistItem": {
      "title": "BagChecklistItem",
      "description": "Item checklist persiapan tas sekolah harian milik siswa.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dayKey": {
          "type": "string",
          "enum": ["senin", "selasa", "rabu", "kamis", "jumat", "sabtu", "minggu"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "emoji": {
          "type": "string",
          "maxLength": 16
        },
        "checked": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "dayKey", "label", "emoji", "checked", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Dokumen profil siswa pribadi. Hanya dapat dibaca dan diubah oleh pemilik UID."
    },
    "/users/{userId}/schedules/{dayKey}": {
      "schema": {
        "$ref": "#/entities/DaySchedule"
      },
      "description": "Jadwal pelajaran dan kegiatan harian pribadi per hari (senin..minggu)."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/HomeworkTask"
      },
      "description": "Daftar catatan PR dan tugas sekolah pribadi milik siswa."
    },
    "/users/{userId}/checklist/{itemId}": {
      "schema": {
        "$ref": "#/entities/BagChecklistItem"
      },
      "description": "Daftar checklist persiapan tas harian pribadi milik siswa."
    }
  }
}

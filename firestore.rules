rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDayKey(dayKey) {
      return dayKey in ['senin', 'selasa', 'rabu', 'kamis', 'jumat', 'sabtu', 'minggu'];
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'className', 'avatarId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'className', 'avatarId', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 160
        && data.fullName is string
        && data.fullName.size() >= 1
        && data.fullName.size() <= 80
        && data.className is string
        && data.className.size() >= 1
        && data.className.size() <= 16
        && data.avatarId in ['mint', 'yellow', 'sky', 'lavender']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDaySchedule(data, userId, dayKey) {
      return data.keys().hasAll([
          'userId',
          'dayKey',
          'morningTitle',
          'morningTime',
          'morningEmoji',
          'morningNote',
          'lessons',
          'extracurriculars',
          'dailyQuote',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'dayKey',
          'morningTitle',
          'morningTime',
          'morningEmoji',
          'morningNote',
          'lessons',
          'extracurriculars',
          'dailyQuote',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.dayKey == dayKey
        && isValidDayKey(data.dayKey)
        && data.morningTitle is string
        && data.morningTitle.size() <= 120
        && data.morningTime is string
        && data.morningTime.size() <= 40
        && data.morningEmoji is string
        && data.morningEmoji.size() <= 16
        && data.morningNote is string
        && data.morningNote.size() <= 240
        && data.lessons is list
        && data.lessons.size() <= 20
        && (data.lessons.size() == 0 || data.lessons[0] is map)
        && data.extracurriculars is list
        && data.extracurriculars.size() <= 10
        && (data.extracurriculars.size() == 0 || data.extracurriculars[0] is map)
        && data.dailyQuote is string
        && data.dailyQuote.size() <= 280
        && data.updatedAt is timestamp;
    }

    function isValidHomeworkTask(data, userId) {
      return data.keys().hasAll(['userId', 'dayKey', 'subject', 'title', 'notes', 'dueDate', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'dayKey', 'subject', 'title', 'notes', 'dueDate', 'completed', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidDayKey(data.dayKey)
        && data.subject is string
        && data.subject.size() >= 1
        && data.subject.size() <= 80
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.notes is string
        && data.notes.size() <= 400
        && data.dueDate is string
        && data.dueDate.size() <= 40
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChecklistItem(data, userId) {
      return data.keys().hasAll(['userId', 'dayKey', 'label', 'emoji', 'checked', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'dayKey', 'label', 'emoji', 'checked', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidDayKey(data.dayKey)
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 120
        && data.emoji is string
        && data.emoji.size() <= 16
        && data.checked is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'className', 'avatarId', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId);

      match /schedules/{dayKey} {
        allow get: if isValidId(userId) && isValidDayKey(dayKey) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidDayKey(dayKey)
          && isOwner(userId)
          && isValidDaySchedule(incoming(), userId, dayKey)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidDayKey(dayKey)
          && isOwner(userId)
          && isValidDaySchedule(incoming(), userId, dayKey)
          && incoming().userId == existing().userId
          && incoming().dayKey == existing().dayKey
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'morningTitle',
            'morningTime',
            'morningEmoji',
            'morningNote',
            'lessons',
            'extracurriculars',
            'dailyQuote',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidDayKey(dayKey) && isOwner(userId);
      }

      match /tasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidHomeworkTask(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidHomeworkTask(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['dayKey', 'subject', 'title', 'notes', 'dueDate', 'completed', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
      }

      match /checklist/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidChecklistItem(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(itemId)
          && isOwner(userId)
          && isValidChecklistItem(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['checked', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['dayKey', 'label', 'emoji', 'checked', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }
    }
  }
}
